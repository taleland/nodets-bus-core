{
  "name": "@taleland/nodets-bus-core",
  "description": "NestJS integration for node-ts bus with named transports and per-module RabbitMQ queues.",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taleland/nodets-bus-core.git"
  },
  "bugs": {
    "url": "https://github.com/taleland/nodets-bus-core/issues"
  },
  "homepage": "https://github.com/taleland/nodets-bus-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "nestjs",
    "rabbitmq",
    "node-ts",
    "bus",
    "events",
    "pubsub"
  ],
  "scripts": {
    "clean": "rm -rf ./dist ./tsconfig.tsbuildinfo",
    "compile": "tsc -b",
    "build": "npm run clean && npm run compile",
    "build:watch": "tsc -b --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test dist/test/*.test.js",
    "test:integration": "node --test dist/test/integration/*.test.js",
    "example": "node dist/examples/module-queues.js",
    "prepack": "npm run build",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@node-ts/bus-core": "^1.3.3",
    "@node-ts/bus-messages": "^1.1.2",
    "fastify": "^5.12.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@node-ts/bus-core": "^1.3.3",
    "@node-ts/bus-messages": "^1.1.2",
    "@node-ts/bus-rabbitmq": "^1.1.2",
    "@taleland/tsconfig": "^1.0.0",
    "@types/node": "^26.6.3",
    "@types/sinon": "^21.0.0",
    "eslint": "^10.4.0",
    "fastify": "^5.12.5",
    "neostandard": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "sinon": "^22.0.0",
    "testcontainers": "^12.0.0",
    "typescript": "6.0.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^25.0.3"
  }
}
